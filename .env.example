# DeadlineIQ — environment variables
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Names only in this file. No values, no examples that look like real keys.

# ─── Backend (Lambda / SAM parameters) ────────────────────────────────────

# DynamoDB table name. Must match the table created by template.yaml.
TABLE_NAME=deadlineiq

# Signing secret for auth tokens (HS256). Generate 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Deployed Vercel app URL. Used as the CORS allowlist — must be exact,
# no trailing slash, never "*".
FRONTEND_URL=

# OpenRouter (or equivalent) API key for the AI features.
# LEAVE THIS BLANK to run the kill-switch test — every AI feature must
# still work via its deterministic fallback.
AI_API_KEY=

# Free-tier chat model identifier from your provider.
AI_MODEL=

# S3 bucket for uploaded assignment briefs (UC-006).
S3_BUCKET=

# SNS topic for reminder delivery (UC-019).
# Leave blank if the Learner Lab blocks SNS and you are using SMTP instead.
SNS_TOPIC_ARN=

# Nodemailer SMTP fallback, used only when SNS_TOPIC_ARN is blank.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Absolute API base, used to build the UC-023 calendar subscription URL the
# student pastes into Google Calendar. SAM sets this from the API's own URL.
API_BASE_URL=

# Shared secret gating POST /api/reminders/run — the manual trigger used
# to demonstrate the reminder pipeline live on stage.
CRON_SECRET=

NODE_ENV=production


# ─── Frontend (set these in the Vercel dashboard, not here) ───────────────

# API Gateway invoke URL, from the `sam deploy` output.
VITE_API_URL=

VITE_ENV=production
