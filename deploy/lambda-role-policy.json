{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SingleTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:TransactWriteItems",
        "dynamodb:TransactGetItems",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/deadlineiq",
        "arn:aws:dynamodb:*:*:table/deadlineiq/index/*"
      ]
    },
    {
      "Sid": "BriefUploadsPresign",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::deadlineiq-briefs-*/*"
    },
    {
      "Sid": "ReminderDelivery",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:*:*:deadlineiq-*"
    }
  ]
}
